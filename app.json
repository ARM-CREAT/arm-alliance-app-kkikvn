{
  "expo": {
    "name": "Alliance ARM",
    "slug": "alliance-arm",
    "version": "1.0.29",
    "orientation": "portrait",
    "icon": "./assets/images/SAVE_20251219_163224.jpg",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/SAVE_20251219_163224.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.Natively",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "production",
        "com.apple.security.application-groups": [
          "group.com.anonymous.Natively.onesignal"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/SAVE_20251219_163224.jpg",
        "backgroundColor": "#000000"
      },
      "package": "com.anonymous.Natively",
      "versionCode": 30
    },
    "web": {
      "favicon": "./assets/images/final_quest_240x240.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "onesignal-expo-plugin",
        {
          "mode": "production"
        }
      ],
      "@react-native-firebase/app",
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-localization",
      [
        "react-native-edge-to-edge",
        {
          "android": {
            "enforceNavigationBarContrast": false
          }
        }
      ],
      "expo-video"
    ],
    "scheme": "alliancearm",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "backendUrl": "https://prod-proj-lcqctzjnnyj98dyvuaf4w-liwg5h36mq-ey.a.run.app",
      "oneSignalAppId": "98ed1b4b-8e0c-4827-830c-03974958721a"
    }
  }
}